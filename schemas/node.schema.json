{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessera:draft:node:1",
  "title": "Portable node view; requires additional semantic/chain validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "economic_rule",
    "node_ref",
    "economic_parent",
    "contributor",
    "name",
    "title",
    "nonce",
    "intent_digest",
    "artifact_sha256",
    "metadata_sha256",
    "metadata_schema",
    "terms_sha256",
    "claim_bps",
    "residual_in_units",
    "effective_units",
    "residual_out_units",
    "issued_total_units",
    "own_payout_numerator_units",
    "own_payout_denominator_units",
    "observed_slot",
    "declared_at",
    "observed_unix_time",
    "depth",
    "custody_mode"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "economic_rule": {
      "const": "residual-v1"
    },
    "node_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genesis_hash",
        "program_id",
        "project_address",
        "node_address"
      ],
      "properties": {
        "genesis_hash": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "program_id": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "project_address": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "node_address": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        }
      }
    },
    "economic_parent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "genesis_hash",
            "program_id",
            "project_address",
            "node_address"
          ],
          "properties": {
            "genesis_hash": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            },
            "program_id": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            },
            "project_address": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            },
            "node_address": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "contributor": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Also enforce maximum 64 UTF-8 bytes; self-chosen, not verified."
    },
    "title": {
      "type": "string",
      "maxLength": 96,
      "description": "Also enforce maximum 96 UTF-8 bytes."
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata_schema": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "terms_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "residual_in_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "effective_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "residual_out_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "issued_total_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "own_payout_numerator_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "own_payout_denominator_units": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "observed_slot": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal integer; semantic validator also enforces u64 and rights-space bounds."
    },
    "declared_at": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,18})$"
    },
    "observed_unix_time": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,18})$"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "custody_mode": {
      "enum": [
        "user_controlled",
        "embedded_provider",
        "server_custodied"
      ]
    }
  }
}
